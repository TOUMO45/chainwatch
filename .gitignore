# Trajectory walker: scratch worktrees, dependency-install cache, run output.
# All reproducible by re-running walker.py; none of it is ground truth.
.walker-worktrees/
.walker-cache/
.walker-out*.json

# Stress/scan run reports. Same category as the above - not ground truth - but
# note .b4-stress.json costs ~12.8h of wall clock to regenerate, so it is kept
# on disk deliberately rather than deleted.
.b4-stress.json
.scan-*.json
.b2-*.json
.e2-*.json

# Real-repo clones analysed in trajectory mode (read-only targets, not ours).
realworld-test/reserve-src/
realworld-test/88mph-src/

# Repositories the web app cloned to analyse. Read-only targets, reproducible
# from the URL the user submitted.
.webapp-clones/

# Agent layer: generated reports. Reproducible from a scan report + the agent.
reports/
realworld-test/v3-core/
realworld-test/v3-periphery/
realworld-test/compound-v2/
realworld-test/aave-v2/

# WALK-L9: the guaranteed-empty directory git is pointed at for hook lookup.
# Kept out of history precisely so it stays EMPTY - see history.hooks_deny_dir.
.git-hooks-denied/

# --- secrets: never commit any env file (a .env.bak leaked a live API key) ---
.env*
!.env.example

